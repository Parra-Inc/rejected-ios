    "We're sorry you found us.\nAdd your rejection to get started!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We're sorry you found us.\nAdd your rejection to get started!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نأسف لأنك وجدتنا.\nأضف رفضك للبدء!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Lamentem que ens hagis trobat.\nAfegeix el teu rebuig per començar!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mrzí nás, že jste nás našli.\nPřidejte své odmítnutí a začněte!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi er kede af, at du fandt os.\nTilføj dit afslag for at komme i gang!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schade, dass du uns gefunden hast.\nFüge deine Absage hinzu, um loszulegen!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λυπόμαστε που μας βρήκες.\nΠρόσθεσε την απόρριψή σου για να ξεκινήσεις!"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "We're sorry you found us.\nAdd your rejection to get started!"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "We're sorry you found us.\nAdd your rejection to get started!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentimos que nos hayas encontrado.\nAñade tu rechazo para empezar."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Lamentamos que nos hayas encontrado.\nAgrega tu rechazo para empezar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Harmi, että löysit meidät.\nLisää hylkäyksesi ja aloita!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous sommes désolés que vous nous ayez trouvés.\nAjoutez votre refus pour commencer !"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous sommes désolés que vous nous ayez trouvés.\nAjoutez votre refus pour commencer !"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצטערים שמצאת אותנו.\nהוסף את הדחייה שלך כדי להתחיל!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें खेद है कि आपको हमारी ज़रूरत पड़ी।\nशुरू करने के लिए अपनी अस्वीकृति जोड़ें!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Žao nam je što si nas pronašao.\nDodaj svoje odbijanje za početak!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Sajnáljuk, hogy ránk találtál.\nAdd hozzá az elutasításodat, és kezdjük!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaf Anda menemukan kami.\nTambahkan penolakan Anda untuk memulai!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci dispiace che tu ci abbia trovati.\nAggiungi il tuo rifiuto per iniziare!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにたどり着いてしまったのは残念です。\n不採用を追加して始めましょう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기까지 오게 되어 안타깝네요.\n거절을 추가해 시작하세요!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaf anda menemui kami.\nTambah penolakan anda untuk bermula!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi er lei for at du fant oss.\nLegg til avslaget ditt for å komme i gang!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jammer dat je ons gevonden hebt.\nVoeg je afwijzing toe om te beginnen!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przykro nam, że nas znalazłeś.\nDodaj swoje odrzucenie, aby zacząć!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lamentamos que você tenha nos encontrado.\nAdicione sua rejeição para começar!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lamentamos que nos tenha encontrado.\nAdicione a sua rejeição para começar!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pare rău că ne-ai găsit.\nAdaugă respingerea ta ca să începi!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жаль, что вы нас нашли.\nДобавьте свой отказ, чтобы начать!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mrzí nás, že ste nás našli.\nPridajte svoje odmietnutie a začnite!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi är ledsna att du hittade oss.\nLägg till ditt avslag för att komma igång!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียใจด้วยที่คุณมาเจอเรา\nเพิ่มการถูกปฏิเสธของคุณเพื่อเริ่มต้น!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bizi bulduğun için üzgünüz.\nBaşlamak için retini ekle!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шкода, що ви нас знайшли.\nДодайте свою відмову, щоб почати!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rất tiếc vì bạn đã tìm đến chúng tôi.\nThêm lần từ chối của bạn để bắt đầu!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很遗憾你需要找到我们。\n添加你的拒绝记录，开始吧！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "很遺憾你需要找到我們。\n新增你的拒絕記錄，開始吧！"
          }
        }
      }
    },
    "Now it's time to turn that frown upside down, get back out there and grind harder!": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now it's time to turn that frown upside down, get back out there and grind harder!"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حان الوقت الآن لتحويل عبوسك إلى ابتسامة، عُد إلى الميدان واجتهد أكثر!"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara és el moment de fer un somriure, tornar a sortir-hi i esforçar-te encara més!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď je čas vyměnit zamračení za úsměv, vrátit se do hry a makat ještě víc!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu er det tid til at vende den sure mine til et smil, komme tilbage og knokle endnu hårdere!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt ist es Zeit, das Stirnrunzeln in ein Lächeln zu verwandeln, weiterzumachen und noch härter zu kämpfen!"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τώρα είναι η ώρα να γυρίσεις το συνοφρύωμα ανάποδα, να ξαναβγείς εκεί έξω και να παλέψεις πιο σκληρά!"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Now it's time to turn that frown upside down, get back out there and grind harder!"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Now it's time to turn that frown upside down, get back out there and grind harder!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora es el momento de cambiar esa cara larga por una sonrisa, salir de nuevo y darlo todo con más ganas."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora es momento de cambiar esa cara larga por una sonrisa, salir de nuevo y darle con más ganas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyt on aika kääntää murjotus hymyksi, palata kentälle ja painaa entistä kovemmin!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est temps de transformer cette grimace en sourire, de repartir au combat et de bosser encore plus dur !"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est temps de transformer cette grimace en sourire, de repartir au combat et de bosser encore plus fort !"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עכשיו הזמן להפוך את הזעף לחיוך, לחזור לזירה ולעבוד קשה יותר!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब समय है उस उदासी को मुस्कान में बदलने का, फिर से मैदान में उतरने और और भी मेहनत करने का!"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sad je vrijeme da namrgođenost pretvoriš u osmijeh, vratiš se u igru i još jače zagriziš!"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Itt az idő, hogy mosolyra fordítsd a búsképet, visszatérj a ringbe és még keményebben hajts!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekarang saatnya mengubah cemberut jadi senyum, kembali ke gelanggang, dan berjuang lebih keras!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora è il momento di trasformare quel broncio in un sorriso, tornare in pista e impegnarti ancora di più!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さあ、しかめっ面を笑顔に変えて、もう一度立ち上がって、もっと頑張ろう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 찡그린 얼굴을 활짝 펴고, 다시 도전해서 더 열심히 달려봐요!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kini masanya tukar muka masam jadi senyuman, kembali ke gelanggang dan berusaha lebih gigih!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Nå er det på tide å snu sutringen til et smil, komme deg ut igjen og stå på enda hardere!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijd om die frons om te draaien, er weer tegenaan te gaan en nóg harder te knallen!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz czas zamienić grymas w uśmiech, wrócić do gry i zaharować się jeszcze bardziej!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora é hora de transformar essa carranca em sorriso, voltar à ativa e ralar ainda mais!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora é hora de transformar esse esgar num sorriso, voltar à carga e dar ainda mais de ti!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acum e momentul să transformi încruntarea în zâmbet, să revii în arenă și să muncești și mai mult!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самое время сменить хмурый взгляд на улыбку, снова выйти на поле и работать ещё усерднее!"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz je čas vymeniť zamračenie za úsmev, vrátiť sa do hry a makať ešte tvrdšie!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu är det dags att byta rynkan mot ett leende, ge dig ut igen och kämpa ännu hårdare!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถึงเวลาเปลี่ยนหน้าบึ้งเป็นรอยยิ้ม กลับออกไปลุยและพยายามให้หนักกว่าเดิม!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi o asık suratı gülümsemeye çevirme, yeniden sahaya çıkıp daha çok çalışma zamanı!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тепер час перетворити похмурий вираз на усмішку, повернутися в гру й працювати ще завзятіше!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ là lúc đổi cái cau mày thành nụ cười, trở lại đường đua và cố gắng hơn nữa!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在是时候把愁眉转成笑脸，重新出发，更拼一点！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在是時候把愁眉轉成笑臉，重新出發，更拼一點！"
          }
        }
      }
    },
    "Remember: doing something nice for others when you're down is the best way to help you feel better :)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember: doing something nice for others when you're down is the best way to help you feel better :)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكّر: فعل شيء لطيف للآخرين حين تكون محبطًا هو أفضل طريقة لتحسين شعورك :)"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorda: fer alguna cosa bona pels altres quan estàs baix és la millor manera de sentir-te millor :)"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamatuj: udělat něco hezkého pro druhé, když je ti mizerně, je nejlepší způsob, jak si zvednout náladu :)"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Husk: at gøre noget godt for andre, når du er nede, er den bedste måde at få det bedre på :)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denk dran: Anderen etwas Gutes zu tun, wenn du am Boden bist, ist der beste Weg, dich besser zu fühlen :)"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θυμήσου: το να κάνεις κάτι όμορφο για τους άλλους όταν είσαι πεσμένος είναι ο καλύτερος τρόπος να νιώσεις καλύτερα :)"
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember: doing something nice for others when you're down is the best way to help you feel better :)"
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Remember: doing something nice for others when you're down is the best way to help you feel better :)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerda: hacer algo bueno por los demás cuando estás mal es la mejor manera de sentirte mejor :)"
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerda: hacer algo lindo por los demás cuando estás mal es la mejor forma de sentirte mejor :)"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muista: jonkin mukavan tekeminen muille, kun olet maassa, on paras tapa piristyä :)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Souviens-toi : faire quelque chose de gentil pour les autres quand tu as le moral à plat est le meilleur moyen d'aller mieux :)"
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Souviens-toi : faire quelque chose de gentil pour les autres quand tu as le moral à plat est le meilleur moyen d'aller mieux :)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זכור: לעשות משהו טוב לאחרים כשאתה בשפל זו הדרך הטובה ביותר להרגיש טוב יותר :)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "याद रखें: जब आप उदास हों तो दूसरों के लिए कुछ अच्छा करना खुद को बेहतर महसूस कराने का सबसे अच्छा तरीका है :)"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapamti: učiniti nešto lijepo za druge kad si na dnu najbolji je način da se osjećaš bolje :)"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne feledd: ha másoknak teszel valami jót, amikor padlón vagy, az a legjobb módja, hogy jobban érezd magad :)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingat: melakukan hal baik untuk orang lain saat sedang terpuruk adalah cara terbaik agar merasa lebih baik :)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricorda: fare qualcosa di bello per gli altri quando sei giù è il modo migliore per sentirti meglio :)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覚えておいて：落ち込んだときこそ誰かに親切にするのが、自分の気分を上げる一番の方法だよ :)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억하세요: 힘들 때 남에게 좋은 일을 하는 것이 기분을 회복하는 가장 좋은 방법이에요 :)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingat: melakukan sesuatu yang baik untuk orang lain ketika sedih ialah cara terbaik untuk rasa lebih baik :)"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Husk: å gjøre noe hyggelig for andre når du er nedfor er den beste måten å få det bedre på :)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onthoud: iets aardigs doen voor anderen als je in de put zit is de beste manier om je beter te voelen :)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamiętaj: zrobienie czegoś miłego dla innych, gdy jesteś na dnie, to najlepszy sposób, by poczuć się lepiej :)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembre-se: fazer algo legal pelos outros quando você está pra baixo é a melhor forma de se sentir melhor :)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembra-te: fazer algo bom pelos outros quando estás em baixo é a melhor forma de te sentires melhor :)"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține minte: să faci ceva frumos pentru ceilalți când ești la pământ e cel mai bun mod să te simți mai bine :)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помни: сделать что-то доброе для других, когда тебе плохо, — лучший способ почувствовать себя лучше :)"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamätaj: urobiť niečo pekné pre druhých, keď ti je ťažko, je najlepší spôsob, ako sa cítiť lepšie :)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom ihåg: att göra något snällt för andra när du är nere är det bästa sättet att må bättre :)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำไว้: การทำสิ่งดีๆ ให้คนอื่นตอนที่คุณท้อ คือวิธีที่ดีที่สุดที่จะทำให้รู้สึกดีขึ้น :)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unutma: kötü hissettiğinde başkalarına iyilik yapmak, kendini daha iyi hissetmenin en güzel yoludur :)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пам’ятай: зробити щось добре для інших, коли тобі зле, — найкращий спосіб почуватися краще :)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy nhớ: làm điều tốt cho người khác khi bạn buồn là cách tuyệt nhất để thấy khá hơn :)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记住：心情低落时为别人做点好事，是让自己感觉变好的最佳方式 :)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記住：心情低落時為別人做點好事，是讓自己感覺變好的最佳方式 :)"
          }
        }
      }
    },
